# Inicio de sesión con Google (opcional). Crea un "ID de cliente OAuth" tipo Web en Google Cloud Console
# y añade http://localhost:5173 y tu dominio como "Orígenes de JavaScript autorizados".
VITE_GOOGLE_CLIENT_ID=

# Pagos con PayPal (suscripciones). Client ID (público) y los tres planes P-XXXX creados en developer.paypal.com.
# El Secret y el ID del webhook NO van aquí: son secretos de Supabase (ver README, "Pagos con PayPal").
VITE_PAYPAL_CLIENT_ID=
VITE_PAYPAL_PLAN_BASIC=
VITE_PAYPAL_PLAN_PRO=
VITE_PAYPAL_PLAN_PRO_PLUS=

# Las credenciales de Instagram/Facebook/Gmail NO van aquí: son secretos de Supabase (ver README, "Conexiones reales").
