# Inicio de sesión con Google (opcional). Crea un "ID de cliente OAuth" tipo Web en Google Cloud Console
# y añade http://localhost:5173 y tu dominio como "Orígenes de JavaScript autorizados".
VITE_GOOGLE_CLIENT_ID=

# Credenciales OAuth reales (opcional). Sin ellas la app funciona en MODO DEMO.
# Requieren registrar tu app en Meta for Developers y TikTok for Developers.
VITE_INSTAGRAM_CLIENT_ID=
VITE_TIKTOK_CLIENT_KEY=
# URL de tu backend que intercambia el "code" por el token y publica (ver README)
VITE_API_BASE=
